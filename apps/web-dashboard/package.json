{
  "name": "mobilecloud-dashboard",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node server/run.mjs dev",
    "dev:web": "next dev --port 3210",
    "dev:realtime": "node server/realtime.mjs",
    "dev:worker": "node --experimental-strip-types server/worker.ts",
    "build": "node server/build.mjs",
    "build:default": "next build",
    "start": "node server/run.mjs start",
    "start:web": "next start --port 3210",
    "test": "node --experimental-strip-types --test lib/server/*.test.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xmldom/xmldom": "^0.9.12",
    "next": "^15.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3"
  }
}
