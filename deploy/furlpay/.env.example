# ── Domain / edge ────────────────────────────────────────────────────────────
# The public identity origin. Must be HTTPS in production.
MOBILECLOUD_PUBLIC_ORIGIN=https://auth.furlpay.com
MOBILECLOUD_ISSUER=https://auth.furlpay.com

# ── Operator bootstrap (first boot only) ─────────────────────────────────────
# Generate with: openssl rand -base64 24
MOBILECLOUD_BOOTSTRAP_EMAIL=owner@furlpay.com
MOBILECLOUD_BOOTSTRAP_PASSWORD=

# ── Signing ─────────────────────────────────────────────────────────────────
# database = development/staging only; kms is blocked until a provider exists.
MOBILECLOUD_KEY_PROVIDER=database
# Optional external RS256 key (PKCS#8 PEM, literal \n allowed):
# MOBILECLOUD_OIDC_PRIVATE_KEY=

# ── FurlPay relying party ───────────────────────────────────────────────────
FURLPAY_OIDC_ENABLED=1
FURLPAY_OIDC_CLIENT_ID=furlpay
FURLPAY_OIDC_CLIENT_SECRET=
FURLPAY_OIDC_REDIRECT_URI=https://furlpay.com/auth/mobilecloud/callback
FURLPAY_OIDC_SCOPES=openid profile email
FURLPAY_OIDC_POST_LOGOUT_REDIRECT_URI=https://furlpay.com/signed-out
FURLPAY_OIDC_BACKCHANNEL_LOGOUT_URI=https://furlpay.com/auth/mobilecloud/backchannel

# ── Cloudflare Tunnel (token-based) ─────────────────────────────────────────
# Create at Zero Trust → Networks → Tunnels → Create a tunnel → Cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# MOBILECLOUD_OIDC_ACCESS_TTL=900000
# MOBILECLOUD_GEOIP=/app/data/geoip.csv
