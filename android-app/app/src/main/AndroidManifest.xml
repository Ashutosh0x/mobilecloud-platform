<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Internet Access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Biometric App Lock gate (GitHub AppLockActivity pattern) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Keeps a CloudShell session alive while the app is backgrounded: the
         foreground service pins the app UID so the tmux server is not
         reclaimed, and the partial wake lock keeps the CPU out of deep sleep
         while a build runs. `specialUse` is declared because the work is a
         user-started shell session rather than a data sync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The session notification is the user-visible proof that the service
         is running; it is requested at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- QR pairing: the scanner library also declares this, kept explicit so the
         permission the app actually depends on is visible in the manifest. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name="com.mobilecloud.MobileCloudApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileCloud"
        tools:targetApi="35">

        <!-- No boot receiver or node service in the console-only build. -->
        <receiver
            android:name="com.mobilecloud.widget.EdgeStatusWidgetReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="@string/widget_edge_status_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/edge_status_widget_info" />
        </receiver>

        <receiver
            android:name="com.mobilecloud.widget.PorSolvencyWidgetReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="@string/widget_por_solvency_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/por_solvency_widget_info" />
        </receiver>

        <activity
            android:name="com.mobilecloud.ui.MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The QR scanner screen (`com.journeyapps.barcodescanner.CaptureActivity`)
             is declared by the zxing-android-embedded manifest and merged in,
             so it needs no entry here. -->

        <!-- Keeps the CloudShell session (and the tmux server behind it) alive
             while the app is in the background. -->
        <service
            android:name="com.mobilecloud.terminal.TerminalSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started developer terminal session and its long-running shell commands alive while the app is backgrounded." />
        </service>
    </application>
</manifest>
