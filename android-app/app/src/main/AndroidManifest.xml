<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Internet Access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- 24/7 Edge Execution & Hardware Wake Locks -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Biometric App Lock gate (GitHub AppLockActivity pattern) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- QR pairing: the scanner library also declares this, kept explicit so the
         permission the app actually depends on is visible in the manifest. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name="com.mobilecloud.MobileCloudApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MobileCloud Node"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileCloud"
        tools:targetApi="35">

        <!-- Autonomous CloudSupervisor Foreground Service -->
        <service
            android:name="com.mobilecloud.service.CloudSupervisorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Decentralized financial compute and edge blockchain trading oracle daemon" />
        </service>

        <!-- Wi-Fi + cellular transport monitor (per-network RTT is not exposed
             to apps, so none is estimated or displayed) -->
        <service
            android:name="com.mobilecloud.service.NetworkBunderService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Boot Receiver for Auto-Start on System Restart -->
        <receiver
            android:name="com.mobilecloud.service.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Glance home-screen widgets (GitHub 4-widget pattern → PoR/edge slots) -->
        <receiver
            android:name="com.mobilecloud.widget.EdgeStatusWidgetReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="MobileCloud Edge Status">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/edge_status_widget_info" />
        </receiver>

        <receiver
            android:name="com.mobilecloud.widget.PorSolvencyWidgetReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="FurlPay PoR Solvency">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/por_solvency_widget_info" />
        </receiver>

        <activity
            android:name="com.mobilecloud.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The QR scanner screen (`com.journeyapps.barcodescanner.CaptureActivity`)
             is declared by the zxing-android-embedded manifest and merged in,
             so it needs no entry here. -->
    </application>
</manifest>
