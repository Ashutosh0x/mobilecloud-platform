# Loopback ingress for public deployment traffic only. Never point this
# reverse proxy (or a tunnel) at the operator listener on port 3000.
{
	admin off
	auto_https off
}

:8080 {
	bind 127.0.0.1
	encode zstd br gzip

	@operator path /api/v1 /api/v1/* /webhook /webhook/* /logs /logs/* /terminal /terminal/* /healthz /healthz/* /metrics /metrics/*
	handle @operator {
		respond 404
	}
	handle {
		reverse_proxy 127.0.0.1:3001 {
			header_up -Authorization
			header_up -Cookie
			header_up -X-Api-Key
			header_up -X-Terminal-Token
			header_up -X-Hub-Signature-256
		}
	}

	header {
		Strict-Transport-Security "max-age=15552000;"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# No request access log here: rejected legacy URLs may carry credentials.
}
